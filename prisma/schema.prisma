generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum CoopRole {
  OWNER
  EDITOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  // Demographics
  street          String?
  city            String?
  state           String?
  zip             String?
  lat             Float?
  lng             Float?
  geocodeTriedAt  DateTime?
  ageRange        String?
  gender          String?
  raceEthnicity   String?

  // Entrepreneurial readiness
  hasIdea         String?
  foundingGroup   String?
  biggestBarrier  String?
  readinessStage  String?
  workedAtCoop    String?
  wouldConvert    String?

  phone           String?
  isImported      Boolean  @default(false)
  emailSubscribed Boolean  @default(false)

  accounts            Account[]
  sessions            Session[]
  coopMemberships     CoopMember[]
  housingMemberships  HousingMember[]
  businessMemberships BusinessMember[]
  proposalsCreated    Proposal[]
  votes               Vote[]
}

model Coop {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isPublic     Boolean @default(false)
  website      String?
  contactEmail String?
  phone        String?
  street       String?
  city         String?
  state        String?
  zip          String?
  lat          Float?
  lng          Float?
  geocodeTriedAt DateTime?

  members         CoopMember[]
  handbookEntries HandbookEntry[]
}

model CoopMember {
  id     String   @id @default(cuid())
  coopId String
  userId String
  role   CoopRole @default(EDITOR)

  coop Coop @relation(fields: [coopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([coopId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Housing Workbook ──────────────────────────────────────────────────────────

enum HousingProjectStatus {
  PLANNING
  RAISING
  PURCHASED
  RENOVATING
  RENTING
  SOLD
}

enum HousingMemberRole {
  OWNER
  EDITOR
}

enum TreasuryEntryType {
  INCOME
  EXPENSE
}

model HousingProject {
  id     String               @id @default(cuid())
  name   String
  status HousingProjectStatus @default(PLANNING)

  // Property
  address         String?
  city            String?
  state           String?
  zip             String?
  lat             Float?
  lng             Float?
  geocodeTriedAt  DateTime?
  purchasePrice   Float?
  renovationCost  Float?
  postRenoValue   Float?
  targetCloseDate DateTime?
  notes           String?

  // Share structure
  totalShares        Int   @default(1000)
  treasuryReservePct Float @default(10)

  // Governance
  quorumPct       Float  @default(60)
  simpleThreshold Float  @default(51)
  superThreshold  Float  @default(75)
  meetingCadence  String @default("Monthly")
  disputeProcess  String @default("Peer mediation first, then community mediation")

  // Renter equity calculation parameters
  mortgageInterestRate Float @default(7.0)
  mortgageLoanTerm     Int   @default(30)

  // Treasury baseline (monthly estimates)
  monthlyRent        Float?
  propertyTax        Float?
  insurance          Float?
  maintenanceReserve Float?
  rainyDayPct        Float  @default(10)

  members         HousingMember[]
  shareholders    HousingShareHolder[]
  treasuryEntries TreasuryEntry[]
  treasuryVotes   TreasuryVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HousingMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      HousingMemberRole @default(EDITOR)

  project HousingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model HousingShareHolder {
  id        String @id @default(cuid())
  projectId String

  name       String
  email      String?
  phone      String?
  shareCount Int
  amountPaid Float   @default(0)
  isTreasury Boolean @default(false)
  notes      String?

  // Renter equity fields
  isRenter        Boolean   @default(false)
  monthlyRentPaid Float?
  moveInDate      DateTime?
  moveOutDate     DateTime?
  equityBalance   Float     @default(0)

  // Lease fields
  securityDeposit      Float?
  leaseEndDate         DateTime?
  occupantCount        Int?
  emergencyContactName  String?
  emergencyContactPhone String?

  project HousingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model TreasuryEntry {
  id        String           @id @default(cuid())
  projectId String
  date      DateTime
  type      TreasuryEntryType
  category  String
  description String?
  amount    Float

  project HousingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model TreasuryVote {
  id          String @id @default(cuid())
  projectId   String
  periodLabel String
  surplus     Float
  decision    String
  amountDistributed Float @default(0)
  notes       String?

  project HousingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ── Entrepreneurial Journey ───────────────────────────────────────────────────

enum BusinessType {
  UNDECIDED
  TRADITIONAL
  COOP
}

enum BusinessStage {
  IDEA
  KNOW_GROUND
  FIND_PEOPLE
  BUILD_STRUCTURE
  TEST_SMALL
  GET_SUPPORT
  SUSTAIN
  GROW
}

enum BusinessMemberRole {
  OWNER
  EDITOR
}

enum ContactType {
  LEAD
  CUSTOMER
  ADVISOR
  PARTNER
  INVESTOR
  TEAM
  OTHER
}

enum DealStage {
  PROSPECT
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum FundingType {
  GRANT
  LOAN
  PRIZE
  INVESTMENT
  OTHER
}

model Business {
  id          String        @id @default(cuid())
  name        String
  description String?
  type        BusinessType  @default(UNDECIDED)
  stage       BusinessStage @default(IDEA)
  industry    String?
  street      String?
  city        String?
  state       String?
  zip         String?
  lat         Float?
  lng         Float?
  geocodeTriedAt DateTime?
  website     String?
  notes       String?

  problemStatement String?
  targetMarket     String?
  uniqueValue      String?

  // Cohort / LEAP fields
  phone           String?
  county          String?
  formationType   String?
  laraId          String?
  laraDate        DateTime?
  naicsCode       String?
  currentFte      Int?
  plannedFte      Int?
  annualRevenue   Float?
  formationDate   DateTime?
  isMinorityOwned    Boolean  @default(false)
  isWomanOwned       Boolean  @default(false)
  isVeteranOwned     Boolean  @default(false)
  isDisabilityOwned  Boolean  @default(false)
  leapStatus      String?
  leapSubmittedAt DateTime?
  isAdminCreated  Boolean  @default(false)
  cohortId        String?
  cohort          Cohort?  @relation(fields: [cohortId], references: [id])

  members      BusinessMember[]
  contacts     Contact[]
  transactions BusinessTransaction[]
  deals        Deal[]
  planEntries  BusinessPlanEntry[]
  funding      BusinessFunding[]
  connections  BusinessConnection[]
  hires        BusinessHire[]
  timeLogs     TrekTimeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cohort {
  id          String     @id @default(cuid())
  name        String     @unique
  program     String?
  year        Int?
  description String?
  createdAt   DateTime   @default(now())
  businesses  Business[]
}

model BusinessMember {
  id         String             @id @default(cuid())
  businessId String
  userId     String
  role       BusinessMemberRole @default(EDITOR)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
}

model Contact {
  id         String      @id @default(cuid())
  businessId String
  type       ContactType @default(LEAD)
  name       String
  email      String?
  phone      String?
  company    String?
  notes      String?
  tags       String[]

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deals    Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deal {
  id         String    @id @default(cuid())
  businessId String
  contactId  String?
  title      String
  value      Float?
  stage      DealStage @default(PROSPECT)
  notes      String?
  closeDate  DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessTransaction {
  id          String          @id @default(cuid())
  businessId  String
  date        DateTime
  type        TransactionType
  category    String
  description String?
  amount      Float

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model BusinessConnection {
  id          String    @id @default(cuid())
  businessId  String
  resource    String
  description String?
  connectedAt DateTime?
  notes       String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessHire {
  id         String    @id @default(cuid())
  businessId String
  fteAdded   Int
  hiredAt    DateTime?
  notes      String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model BusinessFunding {
  id          String      @id @default(cuid())
  businessId  String
  type        FundingType @default(GRANT)
  amount      Float?
  source      String
  receivedAt  DateTime?
  notes       String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrekTimeLog {
  id          String    @id @default(cuid())
  date        DateTime
  quarter     String
  category    String
  hours       Float
  staffMember String
  notes       String?
  businessId  String?

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model BusinessPlanEntry {
  id         String   @id @default(cuid())
  businessId String
  fieldId    String
  value      String
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, fieldId])
}

// ── Proposals + Voting ───────────────────────────────────────────────────────

enum ProposalEntityType {
  COOP
  HOUSING
}

enum ProposalStatus {
  DRAFT
  OPEN
  CLOSED
  PASSED
  FAILED
  WITHDRAWN
}

enum VoteChoice {
  YES
  NO
  ABSTAIN
}

model Proposal {
  id           String             @id @default(cuid())
  entityType   ProposalEntityType
  entityId     String
  title        String
  body         String
  proposedById String
  status       ProposalStatus     @default(DRAFT)
  threshold    Float              @default(51)
  deadline     DateTime?

  offchainYes     Int @default(0)
  offchainNo      Int @default(0)
  offchainAbstain Int @default(0)

  proposedBy User   @relation(fields: [proposedById], references: [id])
  votes      Vote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vote {
  id         String     @id @default(cuid())
  proposalId String
  userId     String
  choice     VoteChoice
  comment    String?

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])

  createdAt DateTime @default(now())
}

// ── RegionPulse Cache ─────────────────────────────────────────────────────────

model RegionPulseCache {
  zip       String   @id
  data      Json
  fetchedAt DateTime @default(now())
}

// ── Co-op Handbook ────────────────────────────────────────────────────────────

model HandbookEntry {
  id        String   @id @default(cuid())
  coopId    String
  fieldId   String
  value     String
  updatedAt DateTime @updatedAt

  coop Coop @relation(fields: [coopId], references: [id], onDelete: Cascade)

  @@unique([coopId, fieldId])
}
