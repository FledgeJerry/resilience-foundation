generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum CoopRole {
  OWNER
  EDITOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  // Demographics
  city            String?
  state           String?
  ageRange        String?
  gender          String?
  raceEthnicity   String?

  // Entrepreneurial readiness
  hasIdea         String?
  foundingGroup   String?
  biggestBarrier  String?
  readinessStage  String?
  workedAtCoop    String?
  wouldConvert    String?

  emailSubscribed Boolean  @default(false)

  accounts            Account[]
  sessions            Session[]
  coopMemberships     CoopMember[]
  housingMemberships  HousingMember[]
  businessMemberships BusinessMember[]
}

model Coop {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isPublic     Boolean @default(false)
  website      String?
  contactEmail String?
  phone        String?

  members         CoopMember[]
  handbookEntries HandbookEntry[]
}

model CoopMember {
  id     String   @id @default(cuid())
  coopId String
  userId String
  role   CoopRole @default(EDITOR)

  coop Coop @relation(fields: [coopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([coopId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Housing Workbook ──────────────────────────────────────────────────────────

enum HousingProjectStatus {
  PLANNING
  RAISING
  PURCHASED
  RENOVATING
  RENTING
  SOLD
}

enum HousingMemberRole {
  OWNER
  EDITOR
}

enum TreasuryEntryType {
  INCOME
  EXPENSE
}

model HousingProject {
  id     String               @id @default(cuid())
  name   String
  status HousingProjectStatus @default(PLANNING)

  // Property
  address         String?
  purchasePrice   Float?
  renovationCost  Float?
  postRenoValue   Float?
  targetCloseDate DateTime?
  notes           String?

  // Share structure
  totalShares        Int   @default(1000)
  treasuryReservePct Float @default(10)

  // Governance
  quorumPct       Float  @default(60)
  simpleThreshold Float  @default(51)
  superThreshold  Float  @default(75)
  meetingCadence  String @default("Monthly")
  disputeProcess  String @default("Peer mediation first, then community mediation")

  // Renter equity calculation parameters
  mortgageInterestRate Float @default(7.0)
  mortgageLoanTerm     Int   @default(30)

  // Treasury baseline (monthly estimates)
  monthlyRent        Float?
  propertyTax        Float?
  insurance          Float?
  maintenanceReserve Float?
  rainyDayPct        Float  @default(10)

  members         HousingMember[]
  shareholders    HousingShareHolder[]
  treasuryEntries TreasuryEntry[]
  treasuryVotes   TreasuryVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HousingMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      HousingMemberRole @default(EDITOR)

  project HousingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model HousingShareHolder {
  id        String @id @default(cuid())
  projectId String

  name       String
  email      String?
  phone      String?
  shareCount Int
  amountPaid Float   @default(0)
  isTreasury Boolean @default(false)
  notes      String?

  // Renter equity fields
  isRenter        Boolean   @default(false)
  monthlyRentPaid Float?
  moveInDate      DateTime?
  equityBalance   Float     @default(0)

  project HousingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model TreasuryEntry {
  id        String           @id @default(cuid())
  projectId String
  date      DateTime
  type      TreasuryEntryType
  category  String
  description String?
  amount    Float

  project HousingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model TreasuryVote {
  id          String @id @default(cuid())
  projectId   String
  periodLabel String
  surplus     Float
  decision    String
  amountDistributed Float @default(0)
  notes       String?

  project HousingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ── Entrepreneurial Journey ───────────────────────────────────────────────────

enum BusinessType {
  UNDECIDED
  TRADITIONAL
  COOP
}

enum BusinessStage {
  IDEA
  KNOW_GROUND
  FIND_PEOPLE
  BUILD_STRUCTURE
  TEST_SMALL
  GET_SUPPORT
  SUSTAIN
  GROW
}

enum BusinessMemberRole {
  OWNER
  EDITOR
}

enum ContactType {
  LEAD
  CUSTOMER
  ADVISOR
  PARTNER
  INVESTOR
  TEAM
  OTHER
}

enum DealStage {
  PROSPECT
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Business {
  id          String        @id @default(cuid())
  name        String
  description String?
  type        BusinessType  @default(UNDECIDED)
  stage       BusinessStage @default(IDEA)
  industry    String?
  city        String?
  state       String?
  website     String?
  notes       String?

  problemStatement String?
  targetMarket     String?
  uniqueValue      String?

  members      BusinessMember[]
  contacts     Contact[]
  transactions BusinessTransaction[]
  deals        Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessMember {
  id         String             @id @default(cuid())
  businessId String
  userId     String
  role       BusinessMemberRole @default(EDITOR)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
}

model Contact {
  id         String      @id @default(cuid())
  businessId String
  type       ContactType @default(LEAD)
  name       String
  email      String?
  phone      String?
  company    String?
  notes      String?
  tags       String[]

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deals    Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deal {
  id         String    @id @default(cuid())
  businessId String
  contactId  String?
  title      String
  value      Float?
  stage      DealStage @default(PROSPECT)
  notes      String?
  closeDate  DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessTransaction {
  id          String          @id @default(cuid())
  businessId  String
  date        DateTime
  type        TransactionType
  category    String
  description String?
  amount      Float

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ── Co-op Handbook ────────────────────────────────────────────────────────────

model HandbookEntry {
  id        String   @id @default(cuid())
  coopId    String
  fieldId   String
  value     String
  updatedAt DateTime @updatedAt

  coop Coop @relation(fields: [coopId], references: [id], onDelete: Cascade)

  @@unique([coopId, fieldId])
}
